# ============================================================
# 招聘情报 Agent —— 环境变量模板
# 用法：复制为 .env 后填写。（.env 已被 gitignore，不会入库）
# ============================================================

# ---- 编译产物输出目录 ----------------------------------------
# 相对「仓库根目录」的路径。默认 ../招聘agent-build
# 即输出到 <项目所在目录>/招聘agent-build
# 想改成仓库内 build/ 就写：BUILD_OUT_DIR=build
BUILD_OUT_DIR=../招聘agent-build

# ---- 本地开发端口 --------------------------------------------
WEB_PORT=5173
SERVER_PORT=8787

# ---- 本地数据目录 --------------------------------------------
# 运行时数据（候选人 / 岗位 / 匹配 / 来源）落盘位置，不入 git。
# 留空则自动解析：优先仓库同级的 招聘agent-data/
# 想放进仓库内就写：DATA_DIR=data
DATA_DIR=../招聘agent-data
# 数据目录为空时是否自动灌入示例数据（1=是，0=否）
SEED_ON_EMPTY=1

# ---- 云端服务（后续接入 cloud-service 时填写）---------------
# 云数据库
CLOUD_DB_URL=
CLOUD_ANON_KEY=
CLOUD_SERVICE_KEY=
# 对象存储（存放简历原件 / 页面快照）
CLOUD_STORAGE_BUCKET=resumes

# ---- 大模型 --------------------------------------------------
# 留空 = 用平台自带免密钥调用；填写 = 用你自己的 Key
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# ---- 采集端（浏览器扩展）-------------------------------------
# 扩展把数据 POST 到哪个后端
VITE_API_BASE=http://localhost:8787
